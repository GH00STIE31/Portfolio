    </div>
    <div class="hero-avatar">
      <style>
        img{
          width: 250px; height: 250px; border-radius: 100%;
        }
      </style>
      <img src="https://raw.githubusercontent.com/GH00STIE31/Portfolio/refs/heads/main/image.png">
    </div>
  </section>


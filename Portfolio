  <section id="skills">
    <h2>Skills</h2>
    <div class="skills-container">
      </div>
      <div class="skill-category">
        <h3>🛠️ Tools</h3>
        <div class="skill-list">
          <span class="skill-item">GitHub</span>
          <span class="skill-item">VS Code</span>
          <span class="skill-item">Microst Office</span>
